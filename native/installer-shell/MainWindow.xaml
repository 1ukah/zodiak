<Window x:Class="ZodiakInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install zodiak" Width="900" Height="580" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True">
  <Window.Resources>
    <Style x:Key="OptionButton" TargetType="Button">
      <Setter Property="Background" Value="#191A20" />
      <Setter Property="BorderBrush" Value="#353642" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#EEEFF5" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="#A8A0FF" />
      <Setter Property="Foreground" Value="#17132B" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="24,13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#292A33" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#25213A" Offset="0" />
            <GradientStop Color="#101114" Offset="1" />
          </LinearGradientBrush>
        </Grid.Background>
        <StackPanel Margin="42,52,42,42" VerticalAlignment="Stretch" HorizontalAlignment="Center">
          <Image Source="Assets/logo.png" Width="120" Height="115" HorizontalAlignment="Center" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
          <TextBlock Text="zodiak" Foreground="#F4F3FF" FontSize="31" FontWeight="SemiBold" Margin="0,26,0,10" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock x:Name="VersionText" Foreground="#77788A" FontSize="12" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Background="#101114" Margin="0">
        <Border Height="42" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown" />
        <Button Panel.ZIndex="1" Content="×" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0" Width="30" Height="30" FontSize="22" Foreground="#A7A8B7" Background="Transparent" BorderThickness="0" Cursor="Hand" />
        <Grid Margin="58,78,58,36">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Button Grid.Row="0" x:Name="JustMeButton" Click="JustMe_Click" Style="{StaticResource OptionButton}">
            <StackPanel>
              <TextBlock Text="Just for me" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="Install only for this Windows account" Foreground="#A7A8B7" FontSize="13" Margin="0,5,0,0" />
            </StackPanel>
          </Button>
          <Button Grid.Row="1" x:Name="AllUsersButton" Click="AllUsers_Click" Style="{StaticResource OptionButton}" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="Everyone on this PC" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="Requires Windows administrator approval" Foreground="#A7A8B7" FontSize="13" Margin="0,5,0,0" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Row="2" Text="INSTALL LOCATION" Foreground="#858697" FontSize="11" FontWeight="SemiBold" Margin="0,30,0,9" />
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /></Grid.ColumnDefinitions>
            <TextBox x:Name="InstallPathText" Grid.Column="0" Background="#191A20" Foreground="#EEEFF5" BorderBrush="#353642" BorderThickness="1" Padding="12,10" FontSize="13" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Background="#292A33" Foreground="#EEEFF5" BorderBrush="#3A3B48" BorderThickness="1" Margin="8,0,0,0" Cursor="Hand" />
          </Grid>
          <Grid Grid.Row="5" Height="54" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="StatusText" Foreground="#858697" FontSize="13" Visibility="Hidden" />
            <ProgressBar Grid.Row="1" x:Name="InstallProgress" Height="3" IsIndeterminate="True" Visibility="Hidden" VerticalAlignment="Bottom" Foreground="#A8A0FF" Background="#292A33" />
          </Grid>
          <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Close_Click" Background="Transparent" Foreground="#B7B8C5" BorderThickness="0" Padding="18,13" Cursor="Hand" />
            <Button x:Name="InstallButton" Content="Install" Click="Install_Click" Style="{StaticResource ActionButton}" Margin="10,0,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>

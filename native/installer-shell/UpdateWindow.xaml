<Window x:Class="ZodiakInstaller.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update zodiak" Width="480" Height="240" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="#101114"
        ContentRendered="Window_ContentRendered" Closing="Window_Closing"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Border BorderBrush="#292A33" BorderThickness="1" Background="#101114">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="142" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid>
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#25213A" Offset="0" /><GradientStop Color="#101114" Offset="1" /></LinearGradientBrush>
        </Grid.Background>
        <Image Source="Assets/logo.png" Width="68" Height="68" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
      </Grid>
      <Grid Grid.Column="1" Margin="30,46,30,28">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Preparing…" Foreground="#EEEFF5" FontSize="17" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="VersionText" Foreground="#77788A" FontSize="12" Margin="0,6,0,0" />
          <ProgressBar x:Name="InstallProgress" Height="3" IsIndeterminate="True" Foreground="#A8A0FF" Background="#292A33" Margin="0,24,0,0" BorderThickness="0" AutomationProperties.Name="Installing update">
            <ProgressBar.Template>
              <ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
                  <Border x:Name="ActivityIndicator" Width="86" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}">
                    <Border.RenderTransform><TranslateTransform x:Name="ActivityOffset" X="-86" /></Border.RenderTransform>
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsIndeterminate" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ActivityOffset" Storyboard.TargetProperty="X" From="-86" To="278" Duration="0:0:1.4" RepeatBehavior="Forever" />
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ProgressBar.Template>
          </ProgressBar>
          <TextBlock x:Name="ErrorText" Text="Please try again." Foreground="#F17B87" FontSize="12" Margin="0,18,0,0" Visibility="Collapsed" />
          <StackPanel x:Name="ErrorActions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0" Visibility="Collapsed">
            <Button x:Name="RetryButton" Click="Retry_Click" Width="40" Height="38" Background="#A8A0FF" Foreground="#17132B" BorderThickness="0" Cursor="Hand" ToolTip="Retry update" AutomationProperties.Name="Retry update">
              <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
              <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M 20,7 L 20,3 M 20,7 L 16,7 M 20,7 A 9,9 0 1 0 21,14" Stroke="#17132B" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
      <Border Grid.ColumnSpan="2" Height="42" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="Window_MouseLeftButtonDown" />
      <Button x:Name="CloseButton" Grid.Column="1" Content="×" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Width="30" Height="30" FontSize="22" Foreground="#A7A8B7" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" ToolTip="Close" AutomationProperties.Name="Close update" />
    </Grid>
  </Border>
</Window>

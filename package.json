{
  "name": "zodiak",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "productName": "zodiak",
  "repository": {
    "type": "git",
    "url": "https://github.com/1ukah/zodiak.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node ./node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:system-audio-capture": "dotnet publish native/system-audio-capture/SystemAudioCapture.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o native/system-audio-capture/publish",
    "version:sync": "node scripts/sync-version.cjs",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-custom-installer.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-custom-installer.ps1 -Publish",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:ui": "electron tests/ui-smoke.cjs",
    "test:chat": "node tests/chat-protocol.cjs && electron tests/chat-ui.cjs",
    "test:chat:live": "electron tests/chat-live.cjs",
    "test:audio": "electron tests/audio-playback.cjs",
    "test:startup": "npm run build && electron tests/startup-smoke.cjs"
  },
  "build": {
    "appId": "app.zodiak",
    "productName": "zodiak",
    "executableName": "zodiak",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "1ukah",
        "repo": "zodiak",
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "build/icon.svg",
        "to": "icon.svg"
      },
      {
        "from": "build/logo.svg",
        "to": "logo.svg"
      },
      {
        "from": "native/system-audio-capture/publish/SystemAudioCapture.exe",
        "to": "system-audio-capture/SystemAudioCapture.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "zodiak-setup.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide": "^1.48.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}

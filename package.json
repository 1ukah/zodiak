{
  "name": "sharescreen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "productName": "Welfare Office",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node ./node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --win portable",
    "build:mac-audio": "node scripts/build-macos-audio.mjs",
    "pack:mac": "npm run build:mac-audio && electron-vite build && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "app.sharescreen",
    "productName": "Welfare Office",
    "executableName": "WelfareOffice",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "extraResources": [
        {
          "from": "native/bin/SystemAudioCapture.exe",
          "to": "SystemAudioCapture.exe"
        }
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Welfare Office.exe"
    },
    "mac": {
      "minimumSystemVersion": "14.2.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "native/bin/macos/SystemAudioCapture.app",
          "to": "Frameworks/SystemAudioCapture.app"
        }
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Welfare Office captures the screen or window you choose when you share.",
        "NSAudioCaptureUsageDescription": "Welfare Office captures system audio when you enable audio sharing."
      }
    }
  },
  "dependencies": {
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
